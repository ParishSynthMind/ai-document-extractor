# Copy to .env (git-ignored) or export in your shell. Never commit a real key.
ANTHROPIC_API_KEY=your-key-here

# QuickBooks Online (used with qbo-push --store file). The refresh token rotates:
# after the first run the newer one lives in .qbo_tokens.json (git-ignored).
QBO_CLIENT_ID=your-intuit-app-client-id
QBO_CLIENT_SECRET=your-intuit-app-client-secret
QBO_REALM_ID=your-company-id
QBO_REFRESH_TOKEN=your-refresh-token

# Xero (used with xero-push --store file). XERO_TENANT_ID and the rotating refresh
# token are written by `xero-push --connect` into .xero_tokens.json (git-ignored).
XERO_CLIENT_ID=your-xero-app-client-id
XERO_CLIENT_SECRET=your-xero-app-client-secret
